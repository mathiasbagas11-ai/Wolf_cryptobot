# ─────────────────────────────────────────────────────────────
# Wolf Crypto Tracker — environment configuration
# Copy to .env and fill in. Variable names match the previous bot
# so an existing Railway / .env config keeps working unchanged.
# ─────────────────────────────────────────────────────────────

# ── Telegram (required for notifications) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Per-topic routing (each message type → its own topic; blank → main channel).
# Reuse the SAME thread IDs from the old bot so every topic lights up:
SIGNAL_THREAD_ID=         # ⭐ Signal Entry (activation / TP updates)
NEW_SIGNAL_THREAD_ID=     # ‼️ New Signal (new signal alerts)
HIGH_CONVICTION_THREAD_ID= # 🎯 High-Conviction (TRAP only; blank → New Signal/Trade Reports)
MARKET_UPDATE_THREAD_ID=  # 📚 Market Update (BTC/ETH bias pulse)
TRADE_REPORT_THREAD_ID=   # 📝 Trade Reports (win/loss resolutions)
NEWS_THREAD_ID=           # 🗞 News Update (crypto headlines)
WHALE_THREAD_ID=          # 👁 Whale Report (large trades)
RADAR_THREAD_ID=          # 🔥 Hot Ecosystem (market radar)
MAJORS_THREAD_ID=         # 🐝 BTC/ETH/SOL (majors session report)
FLOW_THREAD_ID=           # 🧠 Flow Intelligence — give it its OWN topic.
                          # Blank falls back to News. Do NOT point it at the
                          # whale room: that room is event-driven (coordination
                          # detected → alert), this is a periodic digest.
SYSTEM_THREAD_ID=         # startup "online" + diagnostics (blank → General)
STATS_THREAD_ID=          # periodic performance summary
ALLOWED_CHAT_IDS=

# ── Risk gates — align entries with the market & protect equity ──
# Default is "Campur" (hybrid): drawdown is always a HARD pause (protects equity),
# while regime + auto-pause run in MONITOR mode (still emit, but flag + down-score
# so you collect the "what if" record). Flip a gate to a hard block once proven.
REGIME_FILTER_ENABLED=true   # read the market regime and flag against-trend entries
REGIME_SYMBOL=BTCUSDT        # bellwether used to read the regime
REGIME_INTERVAL=1h
REGIME_HARD_BLOCK=false      # true → drop against-regime signals instead of flagging
DRAWDOWN_PAUSE_PCT=15        # HARD: pause ALL new entries once equity is this % below peak
AUTOPAUSE_MIN_TRADES=12      # min graded trades before judging a strategy
AUTOPAUSE_MIN_EXPECTANCY=0.10 # pause when expectancy (avg PnL % per trade) is below this (buffer above breakeven noise)
AUTOPAUSE_MIN_WIN_RATE=38    # fallback only: used when a strategy's avg_pnl is unavailable
AUTOPAUSE_HARD_BLOCK=true    # true → stop emitting the strategy instead of flagging
MAX_ACTIVE_PER_STRATEGY=4    # cap concurrent open positions per strategy (<=0 = unlimited)
MAX_ACTIVE_PER_DIRECTION=6   # cap concurrent open positions per direction LONG/SHORT (<=0 = unlimited)

# ── Composite regime / bounce guard (risk-SCALING on shorts, not a block) ──
# Folds flow signals (F&G, USDT.D, dry powder, chain flow) into a macro context.
# A fresh SHORT into bounce/squeeze risk (extreme fear, or USDT.D rotating into
# risk / at a historic extreme) gets SMALLER size + a higher score bar — never a
# hard block (direction out of extreme fear is uncertain). Covers counter-trend
# shorts (PREDUMP/TRAP/SCALP) too. Start in monitor; flip to live once proven.
COMPOSITE_REGIME_ENABLED=true
BOUNCE_GUARD_MODE=monitor    # monitor = flag + log what-if only; live = apply size/score
FEAR_EXTREME_MAX=25          # Fear & Greed ≤ this = extreme fear
USDTD_RISKOFF_CHANGE_PCT=0.2 # |USDT.D 24h move| ≥ this % = directional risk flag
USDTD_REVERSAL_PERCENTILE=85 # USDT.D above this historic percentile = reversal risk
USDTD_HISTORY_DAYS=90        # rolling USDT.D window kept for the percentile
USDTD_MIN_HISTORY_DAYS=7     # min history before the percentile is trusted
DRY_POWDER_OUTFLOW_PCT=-0.5  # stablecoin 1d supply change ≤ this % = risk-off
FLOW_CONTEXT_TTL_MIN=30      # cache TTL for slow-moving flow dimensions
BOUNCE_SIZE_FACTOR=0.5       # LIVE: shrink a flagged short's risk to this fraction
BOUNCE_MIN_SCORE=88          # LIVE: bounce-risk shorts need at least this score

# ── Trade-plan / position-sizing engine (shown on every signal + /calc) ──
TRADE_PLAN_ENABLED=true      # add leverage/margin/liquidation plan to each signal
MAX_LEVERAGE=10              # largest leverage the bot will ever recommend
MAINTENANCE_MARGIN_RATE=0.005  # exchange MMR (~0.5% majors) for liquidation math
LIQ_SAFETY_BUFFER=2.0        # liquidation must sit >= this × the stop distance away

# ── Universe — which symbols get scanned ──
# Dynamic ranks the whole market by 24h volume (meme coins & other ecosystems
# rotate in as they get liquid); core majors are always included. false = the
# fixed majors list only.
UNIVERSE_DYNAMIC=true
UNIVERSE_TOP_N=30            # how many volume leaders to scan beyond the core majors
UNIVERSE_MIN_QUOTE_VOLUME=10000000  # liquidity floor (USDT 24h quote volume)

# ── Display timezone for timestamps (IANA name). WIB = Asia/Jakarta ──
TIMEZONE=Asia/Jakarta

# ── Crypto news (free, key-less) ── set NEWS_ENABLED=true + NEWS_THREAD_ID
# Auto-pipeline: every NEWS_INTERVAL_MIN it fetches all NEWS_SOURCES, dedups
# across them, ranks by engagement, and posts only genuinely-new items.
NEWS_ENABLED=false
NEWS_PROVIDER=cryptocompare          # legacy single-source (used if NEWS_SOURCES blank)
# Multi-source fan-out (CSV): cryptocompare,reddit,hackernews
NEWS_SOURCES=cryptocompare,reddit,hackernews
NEWS_INTERVAL_MIN=30
NEWS_MAX_ITEMS=3
# Synthesise fresh headlines into one AI brief (needs the narrator's API key).
NEWS_SYNTHESIS_ENABLED=false
NEWS_NARRATOR_PROVIDER=deepseek      # deepseek | groq | gemini | anthropic
NEWS_NARRATOR_MODEL=                 # blank → provider default

# ── Flow Intelligence digest (own topic — see FLOW_THREAD_ID above) ──
# Six sections: market macro, dry powder, chain rotation, institutional flow,
# whale positioning, watchlist. It only RENDERS what the collectors below wrote
# to the state store — it never fetches — so the interval costs nothing but a
# message. How fresh the numbers are is set by the collector intervals, not here.
# The digest is deterministic: no LLM ever phrases its numbers.
FLOW_ENABLED=false
FLOW_INTERVAL_MIN=30
FLOW_MARKETS_LIMIT=60         # coins the macro collector screens for the watchlist
FLOW_MAX_WATCH=5              # watchlist length
# Narrator for the on-demand single-token deep dive (POST /flow/{symbol}) only.
# deepseek | groq | gemini | anthropic — set the matching API key below.
FLOW_NARRATOR_PROVIDER=deepseek
FLOW_NARRATOR_MODEL=          # blank → provider default (deepseek-chat)

# ── On-chain / whale / institutional collectors ──
# Each fetches on its own schedule and writes a snapshot to the state store.
# Two consumers read those snapshots: the Flow Intelligence digest above, and
# the per-symbol signal context (which feeds the whale veto gate and the AI
# debate). One fetch, two consumers, no chance of them disagreeing.
# All of them are optional — with everything false the bot behaves exactly as
# it did before these existed.

# Valuation: CoinGecko markets + DefiLlama TVL → FDV ratio, turnover, distance
# from ATH, MCap/TVL, 30d TVL trend. Hourly, because a 15-symbol universe on the
# 10-minute scan cycle would be 90 CoinGecko calls an hour uncached and the
# key-less API will not carry it. The cache cuts that to ~15; a 429 opens a
# backoff window instead of retrying into a longer ban.
ONCHAIN_VALUATION_ENABLED=false
ONCHAIN_VALUATION_INTERVAL_MIN=60
ONCHAIN_VALUATION_CACHE_TTL_SEC=3600
ONCHAIN_VALUATION_BACKOFF_SEC=900     # quiet period after an HTTP 429
ONCHAIN_VALUATION_MAX_SYMBOLS=15      # cap per run; the universe head is the majors

# Hyperliquid whale scan. One GLOBAL scan per run reads the leaderboard's top
# wallets and every position they hold, producing a per-coin bias — it is not a
# per-symbol lookup. An alert needs MIN_WALLETS distinct wallets moving the same
# way on the same coin in one window; the cooldown stops a build-up unfolding
# across scans from re-alerting every 10 minutes.
WHALE_HL_ENABLED=false
WHALE_HL_INTERVAL_MIN=10
WHALE_HL_TOP_WALLETS=30
WHALE_HL_MIN_POSITION_USD=30000
WHALE_HL_MIN_WALLETS=3                # coordination threshold for an alert
WHALE_HL_COOLDOWN_MIN=60              # per-coin quiet period after alerting

# Coinbase premium — Coinbase BTC/USD vs Binance BTC/USDT, the US-institutional
# demand gauge. BTC ONLY: for every other symbol the field is null and changes
# nothing. Deliberate first cut, so its effect stays measurable.
COINBASE_PREMIUM_ENABLED=false
COINBASE_PREMIUM_INTERVAL_MIN=10

# Market-wide macro snapshot (CoinGecko global + token screen, DefiLlama
# stablecoin supply + per-chain DEX volume). Feeds sections 1-3 and 6 of the
# digest. Required for FLOW_ENABLED to have much to show.
FLOW_MACRO_ENABLED=false
FLOW_MACRO_INTERVAL_MIN=60

# How old a snapshot may be before the SIGNAL PATH treats it as absent. Past
# this the gates and the AI debate see nothing and degrade to candle-only, which
# the bot already handles — gating a live signal on a stale whale read is worse
# than gating it on nothing. (The digest still displays stale data, labelled
# with its age.)
ONCHAIN_STALENESS_MIN=30

# Whale veto gate: drop a signal when this many distinct wallets coordinated
# AGAINST its direction. Deliberately stricter than WHALE_HL_MIN_WALLETS — three
# wallets is worth reporting, overriding a technical setup takes five. Runs
# before the AI debate, so a vetoed signal costs no LLM tokens.
WHALE_VETO_ENABLED=true
WHALE_VETO_MIN_WALLETS=5

# ── Market reports (each posts to its own topic; enable + set the topic id) ──
MAJORS_ENABLED=false
MAJORS_INTERVAL_MIN=60
RADAR_ENABLED=false
RADAR_INTERVAL_MIN=30
RADAR_MIN_QUOTE_VOLUME=5000000
MARKET_PULSE_ENABLED=false
MARKET_PULSE_INTERVAL=30
WHALE_ENABLED=false
WHALE_INTERVAL_MIN=5
WHALE_MIN_USD=250000

# ── Scheduling ──
SCREENER_INTERVAL_MIN=10
TRACKER_INTERVAL_MIN=5
# Periodic Telegram performance summary (hours; 0 disables)
STATS_REPORT_HOURS=24

# ── Tracker tuning ──
TRACKER_DEDUP_MINUTES=30
TRACKER_MAX_OUTCOMES=500
# Grading: once TP1 is banked, book a later breakeven stop as a partial win
# (scaled-exit model) instead of a loss. false = legacy all-or-nothing win.
# On by default: at a 1:3 ladder, "reached TP1 then came back" is the most
# common shape of a profitable signal, and the legacy rule called those losses.
TRACKER_TP1_BANKS_WIN=true

# ── Target geometry (one place decides every signal's reward:risk) ──
# The final take-profit sits this many times the stop distance away. 3 = 1:3.
# Detectors choose only where the stop goes — often a structural level — and
# the rungs are placed off that real distance, so the ratio survives a stop
# that has to be widened to clear a wick.
RISK_RR_TARGET=3
# Rung placement as fractions of the target (0.333,0.667,1 -> 1R, 2R, 3R).
RISK_TP_FRACTIONS=0.3333,0.6667,1.0
# Fraction of the position closed at each rung. This is what a trade actually
# returns: with these weights a full run banks 1.7R, not 3R, so the win rate
# has to beat ~37% to profit — not the ~25% the headline ratio implies.
RISK_TP_ALLOCATIONS=0.5,0.3,0.2
# When one candle reaches both a take-profit and the stop, infer the order from
# the bar's direction (a bar closing down printed its high first, and vice
# versa) so a TP1 that plainly filled still counts. false = always assume the
# stop went first.
INTRABAR_TP_FIRST=true
# Minimum reward:risk to emit a signal at all. Just under RISK_RR_TARGET so
# structural stops and rounding don't trip it.
MIN_SIGNAL_RR=2.5

# Refuse a signal whose stop sits so close that the round trip eats more than
# this fraction of 1R. A stop 0.12% from entry pays 1.67R in fees at 20bps —
# a guaranteed loser however good the setup or the ratio looks.
MAX_COST_R=0.5

# ── Order flow ──
# Reject a setup when the aggressive side of the tape opposes it — a breakout
# being sold into, a squeeze releasing downward. Needs a venue that publishes
# the taker split (Binance does; others degrade to price-only and never veto).
FLOW_VETO=true

# ── Paper trading account (drives Trade Report balance/PnL) ──
# Virtual balance that compounds as signals resolve, risking PAPER_RISK_PCT of
# equity per trade. Not a real exchange balance.
PAPER_START_BALANCE=1000
PAPER_RISK_PCT=1.0

# ── Adaptive learning (per-strategy / per-symbol memory tunes live screening) ──
LEARNING_ENABLED=true
LEARNING_MIN_SAMPLES=5             # trades before a win-rate adjusts the score
LEARNING_MAX_ADJUST=15            # max +/- score points learning may apply
LEARNING_BLACKLIST_MIN_TRADES=8   # bench a symbol after this many trades...
LEARNING_BLACKLIST_MAX_WINRATE=25 # ...if its win-rate is below this %

# ── Backtest warm-start (seed learning from recent candles at boot) ──
BACKTEST_WARM_START=true
BACKTEST_LOOKBACK=50              # candles replayed per symbol
BACKTEST_CANDLE_LIMIT=250

# ── Data sources (ordered fallback: first that responds wins) ──
# Available: binance, okx, bybit, gate. Funding rate is read from binance/okx/
# bybit (in this order); gate is klines/price only.
EXCHANGES=binance,okx,bybit,gate

# ── HTTP / storage ──
HTTP_TIMEOUT=10
# Where signal history is persisted. LEAVE BLANK on Railway once a volume is
# attached: the mount path is picked up automatically. A relative path (or any
# path outside the volume) lives in the container and is wiped on every
# redeploy, which silently resets the sample the auto-pause and learning gates
# judge on — the startup card says which of the two you are running.
STATE_DIR=

# ── API server ──
API_HOST=0.0.0.0
API_PORT=8000
# When set, state-mutating endpoints (POST /scan, /track, /signals) require this
# value in the X-API-Key header. Leave empty to keep the API open (local dev).
API_KEY=

# ── Logging ──
LOG_LEVEL=INFO

# ── AI debate layer (Bull vs Bear + arbiter) ──
# Off by default. When enabled, the best candidate per symbol is debated and an
# arbiter may veto low-quality signals. Each role runs on a cheap OpenAI-compat
# provider (no pricey Claude): DeepSeek = bull, Groq = bear, Hermes = arbiter.
# Supported providers: deepseek, groq, hermes, openrouter, anthropic.
AI_DEBATE_ENABLED=false
DEBATE_BULL_PROVIDER=deepseek
DEBATE_BULL_MODEL=deepseek-chat
DEBATE_BEAR_PROVIDER=groq
DEBATE_BEAR_MODEL=llama-3.3-70b-versatile
DEBATE_ARBITER_PROVIDER=hermes
DEBATE_ARBITER_MODEL=nousresearch/hermes-3-llama-3.1-405b
AI_VETO_ENABLED=true
AI_VETO_MIN_CONFIDENCE=70

# ── Optional integrations (same vars as the previous bot) ──
GEMINI_API_KEY=
GROQ_API_KEY=          # bear debater
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=      # bull debater
HERMES_API_KEY=        # arbiter (OpenRouter key — hosts Nous Hermes)
NEWSAPI_KEY=
TWITTER_BEARER_TOKEN=
GLASSNODE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Anomaly scanner — PAPER MODE (Phase 7) ──
# Appends an ANOMALY SCANNER section (coiling / volume anomaly, 2-6 week swing)
# to the flow-intelligence message. Advisory only — never auto-executes.
ANOMALY_ENABLED=true
ANOMALY_MIN_SCORE=55
ANOMALY_MAX_PICKS=3
ANOMALY_PAPER_MODE=true
# Runtime discipline (CoinGecko free tier · Railway < 8 min/cycle):
ANOMALY_SCAN_LIMIT=50           # coins scanned per cycle (top by 24h volume)
ANOMALY_TIME_BUDGET_SEC=360     # wall-clock stop for the scan loop
ANOMALY_BACKFILL_INTERVAL_HOURS=24

# ── Anomaly scanner — Google-Sheet paper-trade log (Phase 6) ──
# Logs every signal scoring >= 55 to a Google Sheet for expectancy evaluation.
# Disabled by default; the scanner still runs and posts to Telegram without it.
ANOMALY_PAPER_ENABLED=false
# Google service-account credentials: a path to the JSON key file OR the raw
# JSON string. Share the target sheet with the service account's client_email.
GOOGLE_SHEETS_CREDENTIALS=
# Spreadsheet title (created if missing).
ANOMALY_SHEET_NAME=Anomaly_Paper_Log
